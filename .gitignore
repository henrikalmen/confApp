# Dependencies
node_modules/

# Build output
dist/
build/
.next/
out/
.tsbuild/
*.tsbuildinfo

# Visual validation output (regenerated by `npm run screenshots`)
screenshots/
test-results/
playwright-report/

# Wireframe viewport captures are evidence, not regenerated build output: they are what a wireframe
# set was signed off against, and they are cited by the validation report beside them. `screenshots/`
# above is a bare directory pattern and so matches at every depth, which would otherwise swallow them.
!docs/wireframes/**/screenshots/
!docs/wireframes/**/screenshots/**

# Environment
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Agent workspace (transient)
.agent_temp/

# Per-developer session-local state (never committed)
docs/STATE.local.md
