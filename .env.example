# Copy to `.env` and adjust. `.env` is untracked and must never be committed – `.gitignore`
# excludes `.env` and `.env.*` while allowing this file.
#
# Every value here is a non-secret placeholder. The local database password is a development
# credential only; it never leaves this machine and is not the deployed environment's secret
# (S13 owns secret handling there).

# ---------- PostgreSQL ----------
POSTGRES_USER=confapp
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=confapp

# Host port the composed database is published on. 5432 is deliberately avoided: a natively
# installed PostgreSQL commonly holds it, and the collision is confusing to diagnose.
POSTGRES_HOST_PORT=5434

# ---------- Host ports for the application containers ----------
API_HOST_PORT=8081
WEB_HOST_PORT=8082

# ---------- API ----------
LOG_LEVEL=info

# ---------- SPA ----------
# What the browser calls. Same-origin by default; the SPA container proxies /api/ to the API.
# Set an absolute URL (https://api.example.com/api) for a split-origin deployment or the
# Capacitor shell. No trailing slash.
API_BASE_URL=/api

# ---------- Google Workspace sign-in (S02) ----------
# Create an OAuth client in Google Cloud Console -> APIs & Services -> Credentials.
# NONE of these are secrets except GOOGLE_WEB_CLIENT_SECRET, which is read by the API only and
# is never sent to the browser: the SPA runs PKCE and the API brokers the code exchange,
# because Google's token endpoint requires a secret for the Web application client type.

# The Workspace domain allowed to sign in. Verified server-side on the ID token's `hd` claim.
# The `hd` request parameter only pre-fills Google's account chooser and restricts nobody, so
# leaving this unset is not "no restriction" – the API refuses to start without it.
GOOGLE_HOSTED_DOMAIN=ourcompany.example

# Comma-separated allow-list of confApp's OWN OAuth client IDs, one per platform. Google issues
# a distinct client ID for web, Android (bound to package name + signing fingerprint) and iOS
# (bound to bundle ID), and a token carries the minting platform's ID in `aud`. S11 adds its
# Android and iOS IDs here and changes no verification code. Literal IDs only – a wildcard or
# pattern entry is refused at startup, because it would admit another application's tokens.
GOOGLE_AUDIENCE_ALLOWLIST=000000000000-web.apps.googleusercontent.com

# The web OAuth client used for the server-side code exchange. The ID is public; the secret is
# not, and must never be copied into web/public/config.js or any SPA build.
GOOGLE_WEB_CLIENT_ID=000000000000-web.apps.googleusercontent.com
GOOGLE_WEB_CLIENT_SECRET=replace-with-the-web-client-secret

# Must match a redirect URI registered on the web OAuth client, exactly.
GOOGLE_REDIRECT_URI=http://localhost:8082/auth/callback

# ---------- Host-side tooling ----------
# Used by the documented migrate commands and by the integration tests, which run on the host
# against the published port above. Keep the credentials in step with POSTGRES_* .
DATABASE_URL=postgres://confapp:change-me-locally@127.0.0.1:5434/confapp

# The integration tests create and drop their own database, so a migrate-down cycle can never
# touch the development data. Point this at the same server, a different database name.
TEST_DATABASE_URL=postgres://confapp:change-me-locally@127.0.0.1:5434/confapp_test
