{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "types": ["node"],
    // Source imports carry the real `.ts` extension so Node can run src/ directly in the
    // dev loop; tsc rewrites them to `.js` on emit so dist/ is valid Node ESM.
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true
  },
  "include": ["src/**/*.ts"]
}
